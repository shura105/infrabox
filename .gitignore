__pycache__/
*.pyc
venv/

# Logs
log/
core/service/log/

# Config backups (runtime)
core/service/config/backup/

# Mosquitto runtime data
core/mosquitto/mosquitto-real/data/
core/mosquitto/mosquitto-sim/data/
core/mosquitto/mosquitto-real/log/
core/mosquitto/mosquitto-sim/log/

# Archive runtime data
arch/archivator/data/

# Redis runtime data
core/redis/data/dump.rdb

# Mac OS
.DS_Store
**/.DS_Store

# Sensitive configs
core/tools/agent/.env
infrabox-agent/.env
ui/data/
# TLS — environment-specific (each install regenerates with mkcert)
ui/frontend/ssl/*
!ui/frontend/ssl/README.md

# Service discovery — .env генерує 3_deploy (адреса core), не версіонувати
adm/.env
arch/.env
core/.env
ui/.env

# Low-level constructor — runtime data (per-deployment, live on server)
lowlevel/projects/*
!lowlevel/projects/.gitkeep
lowlevel/knowledge/*
!lowlevel/knowledge/.gitkeep

# Sensitive host manifest (contains SSH private key) — never version
core/service/config/infrabox.json
core/service/config/infrabox.db
